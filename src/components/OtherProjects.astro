---
import projects from '../content/projects.json';
---

<section class="section" id="other">
  <h2>other projects</h2>
  <div class="rows">
    {projects.other.map((project) => (
      <div class="row">
        <span>{project.title}</span>
        <span class="row-stack">{project.stack}</span>
        <span class="links">
          {project.liveUrl && <a href={project.liveUrl} target="_blank" rel="noopener">live ↗</a>}
          <a href={project.sourceUrl} target="_blank" rel="noopener">source ↗</a>
        </span>
      </div>
    ))}
  </div>
</section>
