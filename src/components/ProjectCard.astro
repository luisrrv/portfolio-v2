---
interface Props {
  title: string;
  description: string;
  image: string;
  tags: string[];
  liveUrl?: string | null;
  sourceUrl: string;
  noteUrl?: string;
}

const { title, description, image, tags, liveUrl, sourceUrl, noteUrl } = Astro.props;
---

<article class="proj">
  <div class="thumb">
    <img
      src={image}
      alt={`Screenshot of ${title}`}
      width="800"
      height="500"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div>
    <h3>{title}</h3>
    <p class="proj-desc">{description}</p>
    <p class="proj-stack">{tags.join(' · ')}</p>
    <p class="links">
      {liveUrl && <a href={liveUrl} target="_blank" rel="noopener">live ↗</a>}
      <a href={sourceUrl} target="_blank" rel="noopener">source ↗</a>
      {noteUrl && <a href={noteUrl}>write-up</a>}
    </p>
  </div>
</article>
